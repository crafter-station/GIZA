{
	"name": "giza",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test:unit": "vitest",
		"test": "vitest --run",
		"test:e2e": "playwright test",
		"build:terrain": "node tools/build-terrain.ts",
		"qa:browser": "agent-browser"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@fontsource-variable/cormorant-garamond": "5.3.0",
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource/noto-sans-egyptian-hieroglyphs": "5.3.0",
		"@gltf-transform/cli": "4.5.1",
		"@gltf-transform/core": "4.5.1",
		"@gltf-transform/extensions": "4.5.1",
		"@gltf-transform/functions": "4.5.1",
		"@iconify-icons/lucide": "2.0.26",
		"@iconify/svelte": "5.2.3",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/draco3dgltf": "1.4.3",
		"@types/node": "^24.19.2",
		"@types/three": "0.187.0",
		"@vitest/browser-playwright": "4.1.12",
		"agent-browser": "0.41.0",
		"bits-ui": "2.20.2",
		"draco3dgltf": "1.5.9",
		"geotiff": "3.0.5",
		"lil-gui": "0.21.0",
		"meshoptimizer": "1.3.0",
		"playwright": "1.64.1",
		"stats-gl": "4.2.3",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"vitest": "4.1.12",
		"vitest-browser-svelte": "2.2.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@dimforge/rapier3d-simd-compat": "0.21.0",
		"gsap": "3.15.0",
		"lenis": "1.3.27",
		"suncalc": "2.1.1",
		"three": "0.187.0"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.25.0"
}
